{
  "expo": {
    "name": "Travelers Safety Covered",
    "slug": "tsc",
    "scheme": "tsc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/tsc-logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.core1enterprisesolutions.tsc"
    },
    "android": {
      "package": "com.core1enterprisesolutions.tsc",
      "adaptiveIcon": {
        "backgroundColor": "#071D49",
        "foregroundImage": "./assets/tsc-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tsc-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#071D49"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TSC to share your location during an active journey when you choose to enable GPS tracking."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1024e67c-b8c7-41d6-8323-6ca6bf68fd78"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1024e67c-b8c7-41d6-8323-6ca6bf68fd78"
    }
  }
}
